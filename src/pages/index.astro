---
// Config editabile — corrisponde alle props del design.
const substackUrl = "https://substack.com/";
const linkedinUrl = "https://www.linkedin.com/in/m-destefano/";
const githubUrl = "https://github.com/mdestefano";
const scholarUrl = "https://scholar.google.com/citations?user=6fELld4AAAAJ&hl=it";
const xUrl = "https://twitter.com/ManuelDeStefan0";
const mostraX = true;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manuel De Stefano — AI engineer</title>
    <meta
      name="description"
      content="Manuel De Stefano, AI engineer. La qualità dei sistemi AI si misura, non si spera. Ogni due settimane un esperimento e i suoi numeri."
    />
    <link rel="canonical" href="https://mdestefano.github.io/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="wrap head">
        <span class="mono brand">MDS</span>
        <a href="#newsletter" class="mono btn btn-accent head-cta">Newsletter</a>
      </header>

      <main class="wrap main">
        <section class="sec hero">
          <div class="hero-top">
            <h1 class="hero-name">Manuel<br />De Stefano</h1>
            <img
              src="/foto-profilo.png"
              alt="Manuel De Stefano"
              width="336"
              height="336"
              class="avatar"
            />
          </div>
          <p class="mono role">AI engineer</p>
          <p class="claim">La qualità dei sistemi AI si misura, non si spera.</p>
        </section>

        <section id="chi-sono" class="sec">
          <div class="sec-head">
            <span class="mono sec-num">01</span>
            <h2 class="mono sec-title">Chi sono</h2>
          </div>
          <div class="prose">
            <p>Sono un AI engineer. Prima facevo ricerca: Ph.D. in Informatica all'Università di Salerno.</p>
            <p>Lavoro su come si misura quello che l'AI produce, che sia una feature, un prompt o del codice. Ne scrivo ogni due settimane.</p>
          </div>
        </section>

        <section id="newsletter" class="sec">
          <div class="sec-head">
            <span class="mono sec-num">02</span>
            <h2 class="mono sec-title">La newsletter</h2>
          </div>
          <div class="card">
            <p class="card-title">Ogni due settimane, un esperimento e i suoi numeri.</p>
            <div class="btn-row">
              <a href={substackUrl} target="_blank" rel="noopener" class="mono btn btn-white">Iscriviti su Substack</a>
              <a href={linkedinUrl} target="_blank" rel="noopener" class="mono btn btn-ghost">Seguimi su LinkedIn</a>
            </div>
          </div>
        </section>

        <section id="contatto" class="sec sec-last">
          <div class="sec-head">
            <span class="mono sec-num">03</span>
            <h2 class="mono sec-title">Contatto</h2>
          </div>
          <p class="prose">Per scrivermi: messaggio diretto su LinkedIn.</p>
          <a href={linkedinUrl} target="_blank" rel="noopener" class="mono btn btn-dark">Scrivimi su LinkedIn ↗</a>
        </section>
      </main>

      <footer class="wrap foot">
        <span class="mono copy">© 2026 Manuel De Stefano</span>
        <nav class="foot-nav">
          <a href={githubUrl} target="_blank" rel="noopener" class="mono foot-link">GitHub</a>
          <a href={linkedinUrl} target="_blank" rel="noopener" class="mono foot-link">LinkedIn</a>
          {mostraX && <a href={xUrl} target="_blank" rel="noopener" class="mono foot-link">X</a>}
          <a href={scholarUrl} target="_blank" rel="noopener" class="mono foot-link">Scholar</a>
        </nav>
      </footer>
    </div>

    <style>
      :root {
        --ink: #10161c;
        --accent: #0e7fd6;
        --bg: #edf2f6;
        --muted: #5c6770;
      }
      html { scroll-behavior: smooth; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Space Grotesk", Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--ink); text-decoration: none; }
      ::selection { background: var(--accent); color: #fff; }
      .mono { font-family: "JetBrains Mono", monospace; }

      .page {
        min-height: 100vh;
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .wrap { width: 100%; max-width: 820px; }

      /* Header */
      .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 0 14px;
        border-bottom: 3px solid var(--ink);
      }
      .brand {
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 700;
      }

      /* Buttons (shared neobrutalist look) */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 3px solid var(--ink);
        font-weight: 700;
        text-transform: uppercase;
        transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.08s ease, color 0.08s ease;
      }
      .head-cta {
        font-size: 12px;
        letter-spacing: 0.1em;
        padding: 9px 14px;
      }
      .btn-accent { background: var(--accent); color: #fff; box-shadow: 4px 4px 0 var(--ink); }
      .btn-accent:hover { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--ink); color: #fff; }

      .main { display: flex; flex-direction: column; }
      .sec {
        padding: 44px 0;
        border-bottom: 3px solid var(--ink);
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .sec-last { border-bottom: none; padding-bottom: 52px; }

      /* Hero */
      .hero { padding: 52px 0 48px; gap: 26px; }
      .hero-top { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 24px; }
      .hero-name {
        margin: 0;
        flex: 1 1 380px;
        min-width: 260px;
        font-size: clamp(46px, 12vw, 98px);
        line-height: 0.9;
        font-weight: 700;
        letter-spacing: -0.035em;
      }
      .avatar {
        width: clamp(110px, 22vw, 168px);
        height: clamp(110px, 22vw, 168px);
        border-radius: 50%;
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
        object-fit: cover;
        background: var(--accent);
      }
      .role {
        margin: 0;
        font-size: clamp(13px, 3.2vw, 15px);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--accent);
      }
      .claim {
        margin: 0;
        font-size: clamp(21px, 5vw, 30px);
        line-height: 1.25;
        font-weight: 700;
        max-width: 20ch;
        letter-spacing: -0.015em;
        border-left: 6px solid var(--accent);
        padding-left: 16px;
        text-wrap: pretty;
      }

      /* Section headers */
      .sec-head { display: flex; align-items: baseline; gap: 12px; }
      .sec-num { font-size: 12px; font-weight: 700; color: var(--accent); }
      .sec-title {
        margin: 0;
        font-size: 14px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-weight: 700;
      }
      .prose {
        display: flex;
        flex-direction: column;
        gap: 18px;
        font-size: clamp(17px, 4vw, 19px);
        line-height: 1.55;
        max-width: 62ch;
        text-wrap: pretty;
      }
      .prose p { margin: 0; }

      /* Newsletter card */
      .card {
        border: 3px solid var(--ink);
        background: var(--accent);
        color: #fff;
        box-shadow: 8px 8px 0 var(--ink);
        padding: 26px 22px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .card-title {
        margin: 0;
        font-size: clamp(22px, 5.4vw, 32px);
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: -0.02em;
        max-width: 22ch;
        text-wrap: balance;
      }
      .btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 2px; }
      .btn-white,
      .btn-ghost,
      .btn-dark {
        padding: 14px 20px;
        font-size: 13px;
        letter-spacing: 0.06em;
      }
      .btn-white { background: #fff; color: var(--ink); box-shadow: 5px 5px 0 var(--ink); }
      .btn-white:hover { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--ink); }
      .btn-ghost { background: transparent; color: #fff; }
      .btn-ghost:hover { background: var(--ink); color: #fff; }

      /* Contatto */
      .btn-dark {
        align-self: flex-start;
        background: var(--ink);
        color: #fff;
        box-shadow: 5px 5px 0 var(--accent);
      }
      .btn-dark:hover { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--accent); color: #fff; }

      /* Footer */
      .foot {
        border-top: 3px solid var(--ink);
        padding: 20px 0 34px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
      }
      .copy { font-size: 11px; letter-spacing: 0.1em; color: var(--muted); }
      .foot-nav { display: flex; flex-wrap: wrap; gap: 16px; }
      .foot-link {
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        border-bottom: 2px solid transparent;
        transition: color 0.08s ease, border-color 0.08s ease;
      }
      .foot-link:hover { color: var(--ink); border-bottom-color: var(--accent); }
    </style>
  </body>
</html>
