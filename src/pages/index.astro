---
// ponytail: pagina temporanea "in costruzione". La versione completa è nel commit 062b893.
const linkedinUrl = "https://www.linkedin.com/in/m-destefano/";
const githubUrl = "https://github.com/mdestefano";
const scholarUrl = "https://scholar.google.com/citations?user=6fELld4AAAAJ&hl=it";
const xUrl = "https://twitter.com/ManuelDeStefan0";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manuel De Stefano — Sito in costruzione</title>
    <meta name="description" content="Manuel De Stefano. Sito in costruzione." />
    <link rel="canonical" href="https://mdestefano.github.io/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="page">
      <img src="/foto-profilo.png" alt="Manuel De Stefano" width="336" height="336" class="avatar" />
      <h1 class="name">Manuel De Stefano</h1>
      <p class="mono status">Sito in costruzione</p>
      <nav class="links">
        <a href={scholarUrl} target="_blank" rel="noopener" class="mono btn">Google Scholar</a>
        <a href={linkedinUrl} target="_blank" rel="noopener" class="mono btn">LinkedIn</a>
        <a href={githubUrl} target="_blank" rel="noopener" class="mono btn">GitHub</a>
        <a href={xUrl} target="_blank" rel="noopener" class="mono btn">X</a>
      </nav>
    </main>

    <style>
      :root {
        --ink: #10161c;
        --accent: #0e7fd6;
        --bg: #edf2f6;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Space Grotesk", Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--ink); text-decoration: none; }
      .mono { font-family: "JetBrains Mono", monospace; }

      .page {
        min-height: 100vh;
        padding: 40px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 22px;
        text-align: center;
      }
      .avatar {
        width: clamp(120px, 30vw, 168px);
        height: clamp(120px, 30vw, 168px);
        border-radius: 50%;
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
        object-fit: cover;
        background: var(--accent);
      }
      .name {
        margin: 0;
        font-size: clamp(34px, 9vw, 56px);
        line-height: 1;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      .status {
        margin: 0;
        font-size: 14px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--accent);
      }
      .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
      .btn {
        border: 3px solid var(--ink);
        background: #fff;
        box-shadow: 4px 4px 0 var(--ink);
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: transform 0.08s ease, box-shadow 0.08s ease;
      }
      .btn:hover { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--ink); }
    </style>
  </body>
</html>
